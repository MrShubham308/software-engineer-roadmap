# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="your-jwt-secret-key"

# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/roadmap_app or MongoDB Atlas URI)
# If not provided, an in-memory/embedded persistent JSON document store with full MongoDB compatibility is used automatically.
MONGODB_URI=""
